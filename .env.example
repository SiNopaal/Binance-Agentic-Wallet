# ====================================================================
# BINANCE AGENTIC AIRDROP SNIPER - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your own credentials.
# ====================================================================

# Telegram Scraper Credentials (Telethon)
# Obtain your API ID and API Hash from https://my.telegram.org
TELEGRAM_API_ID=2040
TELEGRAM_API_HASH=b18441a1ff607e10a989891a5462e627
TELEGRAM_SESSION_PATH=session/user.session

# Twitter / X Scraper Credentials (Twikit)
# You can provide path to accounts.json OR direct auth cookies
TWITTER_ACCOUNTS_FILE=accounts.json
TWITTER_ACCOUNT_NAME=your_twitter_username
# Optional: Set direct session cookies instead of accounts.json
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# Multi-Wallet Setup (Binance Agentic Wallet CLI Wrappers)
WALLET_1_NAME=Account 1
WALLET_1_CMD=baw1
WALLET_1_ADDRESS=0x0000000000000000000000000000000000000001

WALLET_2_NAME=Account 2
WALLET_2_CMD=baw2
WALLET_2_ADDRESS=0x0000000000000000000000000000000000000002

WALLET_3_NAME=Account 3
WALLET_3_CMD=baw3
WALLET_3_ADDRESS=0x0000000000000000000000000000000000000003

# BSC Network RPC
BSC_RPC_ENDPOINT=https://bsc-dataseed.binance.org

# Limits & Filters
AGENTIC_SCORE_THRESHOLD=60
MAX_GAS_FEE_LIMIT_BNB=0.0004
MIN_USD_TO_SELL=0.20
